{
  "name": "streamarkr",
  "private": true,
  "version": "0.15.0",
  "type": "module",
  "description": "Streamarkr personal movie and TV tracking PWA.",
  "scripts": {
    "build": "tsc -p tsconfig.json && node generate-sw-manifest.mjs",
    "build:worker": "rm -rf worker-dist && tsc -p tsconfig.worker.json",
    "build:cloudflare": "npm run build:worker",
    "prepare:cloudflare": "node scripts/prepare-cloudflare-deploy.mjs",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "start": "npm run build && node server.mjs",
    "serve": "node server.mjs",
    "test": "rm -rf test-dist && tsc -p tsconfig.tests.json && node --test test-dist/tests/*.test.js tests/cloudflare-deploy-config.test.mjs",
    "test:d1": "node --experimental-sqlite --test tests/d1-schema.test.mjs",
    "test:d1:wrangler": "node scripts/validate-wrangler-d1.mjs",
    "qa:browser": "node browser-qa.mjs && node browser-security-qa.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.55.0",
    "typescript": "5.9.2",
    "wrangler": "4.129.0"
  }
}
